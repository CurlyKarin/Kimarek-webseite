---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const jahre = (await getCollection('jahre')).sort((a, b) => b.data.year - a.data.year);
---

<Base
  title="Die letzten Jahre"
  description="Galerien der Kimarek-Jahre. Die Fotos selbst folgen in einem Speicher des Vereins."
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">Galerie</p>
      <h1>Die letzten Jahre</h1>
    </header>
    <div class="prose">
      <p>
        Hier liegen die Jahre, die auf der bisherigen Website eine Galerie hatten. Die Fotos selbst sind in dieser
        Vorschau noch nicht eingebunden. Sie bleiben beim Verein und werden später aus einem eigenen Speicher gezeigt.
      </p>
    </div>
    <div class="year-grid">
      {
        jahre.map((jahr) => (
          <a class="year-card" href={`/galerie/${jahr.data.year}`}>
            <strong>{jahr.data.year}</strong>
            <span>
              {jahr.data.alben.length} {jahr.data.alben.length === 1 ? 'Album' : 'Alben'}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
