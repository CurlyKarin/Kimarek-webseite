---
import { isCurrent, navigation } from '../data/nav';

interface Props {
  portal?: string;
}

const { portal } = Astro.props;
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="valance" aria-hidden="true"></div>
  <div class="wrap header-bar">
    <a class="brand" href="/">
      <img src="/media/kimarek.png" alt="Kinderzirkus Kimarek" width="280" height="187" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      Menü
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Hauptnavigation">
      {
        navigation.map((item) =>
          item.children ? (
            <details class="nav-drop">
              <summary>{item.label}</summary>
              <ul>
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={isCurrent(path, child.href) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a class="nav-link" href={item.href}>
              {item.label}
            </a>
          ),
        )
      }
      {
        portal && (
          <a class="anmeldung-link" href={portal}>
            Anmeldung
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('#site-nav');
  const drops = document.querySelectorAll('.nav-drop');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    if (!open) {
      drops.forEach((drop) => {
        if (drop instanceof HTMLDetailsElement) drop.open = false;
      });
    }
  });

  drops.forEach((drop) => {
    drop.addEventListener('toggle', () => {
      if (!(drop instanceof HTMLDetailsElement) || !drop.open) return;
      drops.forEach((other) => {
        if (other !== drop && other instanceof HTMLDetailsElement) other.open = false;
      });
    });
  });
</script>
