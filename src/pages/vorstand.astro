---
import { getCollection, getEntry } from 'astro:content';
import Abschnitte from '../components/Abschnitte.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Base from '../layouts/Base.astro';
import { pfad } from '../lib/pfad';

const seite = await getEntry('seiten', 'vorstand');
if (!seite) {
  throw new Error('Vorstandstext fehlt');
}
const abschnitte = (await getCollection('vorstand')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={seite.data.title} description={seite.data.description} hintergrund={pfad('/media/zelt.jpg')}>
  <article class="wrap">
    <Seitenkopf seite={seite} title={seite.data.title} kicker={seite.data.kicker} text />
    <Abschnitte abschnitte={abschnitte} />
  </article>
</Base>
