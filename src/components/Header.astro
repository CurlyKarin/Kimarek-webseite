---
import { isCurrent, navigation } from '../data/nav';
import { pfad } from '../lib/pfad';

interface Props {
  portal?: string;
}

const { portal } = Astro.props;
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="valance" aria-hidden="true"></div>
  <div class="wrap header-bar">
    <a class="brand" href={pfad('/')}>
      <img src={pfad('/media/kimarek.png')} alt="Kinderzirkus Kimarek" width="280" height="187" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      Menü
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Hauptnavigation">
      {
        navigation.map((item) =>
          item.children ? (
            <details class="nav-drop">
              <summary>{item.label}</summary>
              <ul>
                {item.children.map((child) => (
                  <li>
                    <a href={pfad(child.href)} aria-current={isCurrent(path, child.href) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a class="nav-link" href={item.href ? pfad(item.href) : undefined}>
              {item.label}
            </a>
          ),
        )
      }
      {
        portal && (
          <a class="anmeldung-link" href={portal}>
            Anmeldung
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('#site-nav');
  const header = document.querySelector('.site-header');
  const drops = document.querySelectorAll('.nav-drop');

  const closeDrops = (except?: Element) => {
    drops.forEach((drop) => {
      if (drop !== except && drop instanceof HTMLDetailsElement) drop.open = false;
    });
  };

  const closeNav = () => {
    nav?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    closeDrops();
  };

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    if (!open) closeDrops();
  });

  drops.forEach((drop) => {
    drop.querySelector('summary')?.addEventListener('pointerdown', () => {
      closeDrops(drop);
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node) || header?.contains(target)) return;
    closeNav();
  });
</script>
