---
import { getCollection } from 'astro:content';
import Seitenkopf from '../components/Seitenkopf.astro';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const seiten = await getCollection('seiten');
  return seiten
    .filter(
      (seite) =>
        seite.id !== 'start' &&
        seite.id !== 'vorstand' &&
        seite.id !== 'betreuer' &&
        seite.id !== 'geschichte' &&
        seite.id !== 'zelt' &&
        seite.id !== 'kinderwoche' &&
        seite.id !== 'jugendwoche' &&
        seite.id !== 'ablauf' &&
        seite.id !== 'videos' &&
        seite.id !== 'galerie',
    )
    .map((seite) => ({
      params: { slug: seite.id },
      props: { seite },
    }));
}

const { seite } = Astro.props;
---

<Base title={seite.data.title} description={seite.data.description}>
  <article class="wrap">
    <Seitenkopf seite={seite} title={seite.data.title} kicker={seite.data.kicker} text />
  </article>
</Base>
