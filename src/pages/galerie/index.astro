---
import { getCollection, getEntry } from 'astro:content';
import Jahre from '../../components/Jahre.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Base from '../../layouts/Base.astro';
import { jahresCover } from '../../lib/bilder';
import { pfad } from '../../lib/pfad';

const seite = await getEntry('seiten', 'galerie');
if (!seite) {
  throw new Error('Galerieseite fehlt');
}
const jahre = (await getCollection('jahre')).sort((a, b) => b.data.year - a.data.year);
---

<Base title={seite.data.title} description={seite.data.description} hintergrund={pfad('/media/zelt.jpg')}>
  <article class="wrap">
    <Seitenkopf seite={seite} title={seite.data.title} kicker={seite.data.kicker} text />
  </article>
  <div class="wrap">
    <Jahre
      jahre={jahre.map((jahr) => ({
        year: jahr.data.year,
        href: pfad(`/galerie/${jahr.data.year}`),
        cover: jahresCover(jahr.data.year, jahr.data.alben, jahr.data.cover),
        alben: jahr.data.alben.length,
      }))}
    />
  </div>
</Base>
