---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { jahresCover } from '../../lib/bilder';
import { pfad } from '../../lib/pfad';

const jahre = (await getCollection('jahre')).sort((a, b) => b.data.year - a.data.year);
---

<Base
  title="Die letzten Jahre"
  description="Galerien der Kimarek-Jahre."
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">Galerie</p>
      <h1>Die letzten Jahre</h1>
    </header>
    <div class="prose">
      <p>Die Fotos der bisherigen Jahresgalerien. Ein Klick auf ein Jahr öffnet die Alben.</p>
    </div>
    <div class="year-grid">
      {
        jahre.map((jahr) => (
          <a class="year-card" href={pfad(`/galerie/${jahr.data.year}`)}>
            <img src={jahresCover(jahr.data.year, jahr.data.alben)} alt="" />
            <span class="year-card-text">
              <strong>{jahr.data.year}</strong>
              <span>
                {jahr.data.alben.length} {jahr.data.alben.length === 1 ? 'Album' : 'Alben'}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
