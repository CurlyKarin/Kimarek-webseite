---
import { getCollection } from 'astro:content';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Base from '../../layouts/Base.astro';
import { albumBilder } from '../../lib/bilder';
import { pfad } from '../../lib/pfad';

export async function getStaticPaths() {
  const jahre = await getCollection('jahre');
  return jahre.map((jahr) => ({
    params: { jahr: String(jahr.data.year) },
    props: { jahr },
  }));
}

const { jahr } = Astro.props;
const jahre = (await getCollection('jahre')).sort((a, b) => b.data.year - a.data.year);
---

<Base title={String(jahr.data.year)} description={`Kimarek-Galerie ${jahr.data.year}`}>
  <div class="wrap">
    <Seitenkopf title={String(jahr.data.year)}>
      <p slot="kicker" class="kicker">
        <a href={pfad('/galerie')}>Galerie</a>
      </p>
    </Seitenkopf>
    {
      jahr.data.alben.map((album) => (
        <section class="album">
          <h2>{album.titel}</h2>
          <div class="collage">
            {albumBilder(jahr.data.year, album.titel).map((src, index) => (
              <button type="button" class="collage-open">
                <img
                  src={src}
                  alt={`Aufnahme ${index + 1} aus ${album.titel} ${jahr.data.year}`}
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        </section>
      ))
    }
    <dialog class="lightbox">
      <button class="lightbox-close" type="button">Schließen</button>
      <div class="lightbox-stage">
        <button class="lightbox-prev" type="button" aria-label="Vorheriges Foto">←</button>
        <img alt="" draggable="false" />
        <button class="lightbox-next" type="button" aria-label="Nächstes Foto">→</button>
      </div>
      <p class="lightbox-count"></p>
    </dialog>
    <nav class="footer-links" aria-label="Weitere Jahre" style="padding: 1rem 0 3rem;">
      {
        jahre.map((eintrag) => (
          <a
            href={pfad(`/galerie/${eintrag.data.year}`)}
            aria-current={eintrag.data.year === jahr.data.year ? 'page' : undefined}
          >
            {eintrag.data.year}
          </a>
        ))
      }
    </nav>
  </div>
</Base>

<script>
  const dialog = document.querySelector('.lightbox');
  const view = dialog?.querySelector('img');
  const count = dialog?.querySelector('.lightbox-count');
  let photos: HTMLImageElement[] = [];
  let index = 0;

  const show = (next: number) => {
    if (!view || photos.length === 0) return;
    index = (next + photos.length) % photos.length;
    const photo = photos[index];
    view.src = photo.currentSrc || photo.src;
    view.alt = photo.alt;
    if (count) count.textContent = `${index + 1} / ${photos.length}`;
  };

  const layout = (collage: Element) => {
    const buttons = [...collage.querySelectorAll('button')];
    const width = collage.clientWidth;
    if (!width || buttons.length === 0) return;
    const gap = 4;
    const target = width < 640 ? 118 : 168;
    const items = buttons.map((button) => {
      const img = button.querySelector('img');
      const ratio = img instanceof HTMLImageElement && img.naturalWidth ? img.naturalWidth / img.naturalHeight : 1.5;
      return { button, ratio };
    });
    const rows: { button: HTMLButtonElement; ratio: number }[][] = [];
    let row: { button: HTMLButtonElement; ratio: number }[] = [];
    let sum = 0;
    for (const item of items) {
      row.push(item);
      sum += item.ratio;
      if (sum * target + gap * (row.length - 1) >= width) {
        rows.push(row);
        row = [];
        sum = 0;
      }
    }
    if (row.length) rows.push(row);

    collage.replaceChildren();
    rows.forEach((group, rowIndex) => {
      const rowEl = document.createElement('div');
      rowEl.className = 'collage-row';
      const ratioSum = group.reduce((total, item) => total + item.ratio, 0);
      const natural = ratioSum * target + gap * (group.length - 1);
      const last = rowIndex === rows.length - 1 && natural < width * 0.92;
      const height = last ? target : (width - gap * (group.length - 1)) / ratioSum;
      rowEl.style.height = `${height}px`;
      for (const item of group) {
        item.button.style.flex = last ? '0 0 auto' : `${item.ratio} ${item.ratio} 0`;
        item.button.style.width = last ? `${height * item.ratio}px` : '';
        rowEl.append(item.button);
      }
      collage.append(rowEl);
    });
  };

  document.querySelectorAll('.collage').forEach((collage) => {
    const schedule = () => {
      requestAnimationFrame(() => layout(collage));
    };
    collage.querySelectorAll('img').forEach((img) => {
      if (!img.complete) img.addEventListener('load', schedule);
    });
    schedule();
    window.addEventListener('resize', schedule);
    collage.querySelectorAll('.collage-open').forEach((button) => {
      button.addEventListener('click', () => {
        photos = [...collage.querySelectorAll('.collage-open img')];
        const current = button.querySelector('img');
        show(photos.indexOf(current as HTMLImageElement));
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });
  });

  let swipeX = 0;
  let swipeY = 0;
  let ignoreClick = false;

  const go = (next: number) => {
    if (photos.length < 2) return;
    show(next);
  };

  dialog?.querySelector('.lightbox-prev')?.addEventListener('click', () => {
    if (ignoreClick) return;
    go(index - 1);
  });
  dialog?.querySelector('.lightbox-next')?.addEventListener('click', () => {
    if (ignoreClick) return;
    go(index + 1);
  });
  dialog?.querySelector('.lightbox-close')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });

  const stage = dialog?.querySelector('.lightbox-stage');
  if (stage) {
    stage.addEventListener('click', (event) => {
      if (ignoreClick) return;
      if (!(event instanceof MouseEvent)) return;
      const target = event.target;
      if (!(target instanceof Element) || target.closest('button')) return;
      const rect = stage.getBoundingClientRect();
      go(event.clientX - rect.left < rect.width / 2 ? index - 1 : index + 1);
    });
  }

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
  });
  dialog?.addEventListener('touchstart', (event) => {
    if (!(event instanceof TouchEvent)) return;
    const touch = event.touches[0];
    if (!touch) return;
    swipeX = touch.clientX;
    swipeY = touch.clientY;
  });
  dialog?.addEventListener('touchend', (event) => {
    if (!(event instanceof TouchEvent)) return;
    const touch = event.changedTouches[0];
    if (!touch) return;
    const dx = touch.clientX - swipeX;
    const dy = touch.clientY - swipeY;
    if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
    ignoreClick = true;
    window.setTimeout(() => {
      ignoreClick = false;
    }, 500);
    go(dx < 0 ? index + 1 : index - 1);
  });
  dialog?.addEventListener('keydown', (event) => {
    if (!(event instanceof KeyboardEvent)) return;
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      go(index - 1);
    }
    if (event.key === 'ArrowRight') {
      event.preventDefault();
      go(index + 1);
    }
  });
</script>
