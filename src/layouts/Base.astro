---
import '@fontsource/fredoka/latin-400.css';
import '@fontsource/fredoka/500.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { verein, vorschau } from '../config';
import { pfad } from '../lib/pfad';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  hintergrund?: string;
}

const { title, description, hintergrund } = Astro.props;
const termine = await getCollection('termine');
const aktuell = termine.sort((a, b) => b.data.year - a.data.year)[0];
const portal = aktuell?.data.portal;
const documentTitle = title === verein.name ? title : `${title} · ${verein.name}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {vorschau && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={pfad('/favicon.ico')} />
    <title>{documentTitle}</title>
  </head>
  <body
    class={hintergrund ? 'page-open' : undefined}
    style={`--zelt: url('${hintergrund ?? pfad('/media/zelt.jpg')}')`}
  >
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <Header portal={portal} />
    <main id="inhalt">
      <slot />
    </main>
    <script is:inline>
      (function () {
        var roots = document.querySelectorAll('.team-fade');
        for (var r = 0; r < roots.length; r++) {
          var frames = roots[r].getElementsByTagName('img');
          if (frames.length < 2) continue;
          (function (list) {
            var index = 0;
            window.setInterval(function () {
              list[index].classList.remove('is-shown');
              index = (index + 1) % list.length;
              list[index].classList.add('is-shown');
            }, 3000);
          })(frames);
        }
      })();
    </script>
    <script is:inline>
      (function () {
        document.addEventListener('click', function (event) {
          var node = event.target;
          while (node && node !== document) {
            if (node.classList && node.classList.contains('video-start')) break;
            node = node.parentNode;
          }
          if (!node || node === document || !node.getAttribute) return;
          var id = node.getAttribute('data-youtube') || '';
          if (!/^[a-zA-Z0-9_-]{6,}$/.test(id)) return;
          var frame = document.createElement('iframe');
          frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1';
          frame.title = node.getAttribute('data-title') || 'Video';
          frame.setAttribute(
            'allow',
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture',
          );
          frame.setAttribute('allowfullscreen', 'true');
          node.parentNode.replaceChild(frame, node);
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var dialogs = document.getElementsByClassName('lightbox');
        if (!dialogs.length || !window.MutationObserver) return;
        var locked = false;
        var y = 0;
        function lock() {
          if (locked) return;
          y = window.pageYOffset || document.documentElement.scrollTop || 0;
          document.body.style.position = 'fixed';
          document.body.style.top = '-' + y + 'px';
          document.body.style.left = '0';
          document.body.style.right = '0';
          document.body.style.width = '100%';
          locked = true;
        }
        function unlock() {
          if (!locked) return;
          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.left = '';
          document.body.style.right = '';
          document.body.style.width = '';
          locked = false;
          window.scrollTo(0, y);
        }
        for (var i = 0; i < dialogs.length; i++) {
          new MutationObserver(function (records) {
            for (var r = 0; r < records.length; r++) {
              if (records[r].target.hasAttribute('open')) lock();
              else unlock();
            }
          }).observe(dialogs[i], { attributes: true, attributeFilter: ['open'] });
        }
      })();
    </script>
    <Footer portal={portal} />
  </body>
</html>
