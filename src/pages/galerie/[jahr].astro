---
import { getCollection } from 'astro:content';
import GalerieAnsicht from '../../components/GalerieAnsicht.astro';

export async function getStaticPaths() {
  const jahre = await getCollection('jahre');
  return jahre.map((jahr) => ({
    params: { jahr: String(jahr.data.year) },
    props: { year: jahr.data.year },
  }));
}

const { year } = Astro.props;
---

<GalerieAnsicht year={year} />
