---
import { getCollection, getEntry } from 'astro:content';
import Video from '../components/Video.astro';
import Base from '../layouts/Base.astro';
import { pfad } from '../lib/pfad';

const seite = await getEntry('seiten', 'videos');
if (!seite) {
  throw new Error('Videoseite fehlt');
}
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={seite.data.title} description={seite.data.description} hintergrund={pfad('/media/zelt.jpg')}>
  <article class="wrap feature">
    <header class="page-head">
      {seite.data.kicker && <p class="kicker">{seite.data.kicker}</p>}
      <h1>{seite.data.title}</h1>
    </header>
    <div class="prose team-copy">
      <p>
        Die Vorschau zeigt ein Standbild von YouTube. Das Video selbst startet erst, wenn du auf Abspielen klickst — dann wird
        die Verbindung zum Player aufgebaut. Mehr dazu steht in der
        <a href={pfad('/datenschutz')}>Datenschutzerklärung</a>.
      </p>
    </div>
    {
      videos.map((video) => (
        <Video title={video.data.title} youtubeId={video.data.youtubeId} />
      ))
    }
  </article>
</Base>
