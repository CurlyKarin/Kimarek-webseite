---
interface Jahr {
  year: number;
  href: string;
  cover?: string;
  alben: { titel: string; anker: string }[];
}

interface Props {
  jahre: Jahr[];
  aktuell?: number;
}

const { jahre, aktuell } = Astro.props;
---

<div class="jahre-leiste">
  <button type="button" class="jahre-prev" aria-label="Neuere Jahre">←</button>
  <div class="jahre-scroller">
    {
      jahre.map((jahr) => (
        <article class:list={['jahre-card', { 'is-aktiv': jahr.year === aktuell }]}>
          <a class="jahre-bild" href={jahr.href} aria-label={String(jahr.year)}>
            {jahr.cover ? (
              <img src={jahr.cover} alt="" />
            ) : (
              <span class="jahre-bild-leer" />
            )}
          </a>
          <div class="jahre-fuss">
            <a class="jahre-zahl" href={jahr.href} aria-current={jahr.year === aktuell ? 'page' : undefined}>
              <strong>{jahr.year}</strong>
            </a>
            <ul class="jahre-alben">
              {jahr.alben.map((album) => (
                <li>
                  <a href={`${jahr.href}#${album.anker}`}>{album.titel}</a>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
  <button type="button" class="jahre-next" aria-label="Ältere Jahre">→</button>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('.jahre-leiste');
    if (!root) return;
    var scroller = root.querySelector('.jahre-scroller');
    var prev = root.querySelector('.jahre-prev');
    var next = root.querySelector('.jahre-next');
    if (!scroller || !prev || !next) return;

    function step() {
      var card = scroller.querySelector('.jahre-card');
      if (!card) return 0;
      var margin = parseFloat(window.getComputedStyle(card).marginRight) || 0;
      return card.getBoundingClientRect().width + margin;
    }

    function update() {
      var max = scroller.scrollWidth - scroller.clientWidth;
      prev.disabled = scroller.scrollLeft <= 2;
      next.disabled = scroller.scrollLeft >= max - 2;
    }

    prev.addEventListener('click', function () {
      scroller.scrollTo({ left: scroller.scrollLeft - step(), behavior: 'smooth' });
    });
    next.addEventListener('click', function () {
      scroller.scrollTo({ left: scroller.scrollLeft + step(), behavior: 'smooth' });
    });
    scroller.addEventListener('scroll', update);
    window.addEventListener('resize', update);
    var aktiv = scroller.querySelector('.jahre-card.is-aktiv');
    if (aktiv) {
      var rand = parseFloat(window.getComputedStyle(aktiv).marginRight) || 0;
      var rechts = aktiv.offsetLeft + aktiv.offsetWidth + rand;
      if (rechts > scroller.clientWidth) scroller.scrollLeft = rechts - scroller.clientWidth;
    }
    update();
  })();
</script>
