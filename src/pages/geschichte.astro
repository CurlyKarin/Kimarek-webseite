---
import { getCollection, getEntry } from 'astro:content';
import Abschnitte from '../components/Abschnitte.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Base from '../layouts/Base.astro';
import { bild } from '../lib/bilder';

const chapiteau = bild('hintergruende/chappi.JPG');

const seite = await getEntry('seiten', 'geschichte');
if (!seite) {
  throw new Error('Geschichtsseite fehlt');
}
const abschnitte = (await getCollection('geschichte')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={seite.data.title} description={seite.data.description} hintergrund={chapiteau}>
  <article class="wrap">
    <Seitenkopf seite={seite} title={seite.data.title} kicker={seite.data.kicker} text />
    <Abschnitte abschnitte={abschnitte} />
  </article>
</Base>
