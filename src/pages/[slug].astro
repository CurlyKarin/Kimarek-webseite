---
import { getCollection } from 'astro:content';
import Inhaltsseite from '../components/Inhaltsseite.astro';

export async function getStaticPaths() {
  const seiten = await getCollection('seiten');
  return seiten
    .filter((seite) => seite.id !== 'start' && seite.id !== 'galerie')
    .map((seite) => ({
      params: { slug: seite.id },
      props: { seite },
    }));
}

const { seite } = Astro.props;
---

<Inhaltsseite seite={seite} />
