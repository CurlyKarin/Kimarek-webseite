---
import { getEntry, render } from 'astro:content';
import Fotoreihe from '../components/Fotoreihe.astro';
import Base from '../layouts/Base.astro';
import gruppen from '../data/gruppenfotos.json';
import jugend from '../data/jugend.json';
import { bild } from '../lib/bilder';

const seite = await getEntry('seiten', 'jugendwoche');
if (!seite) {
  throw new Error('Jugendwochentext fehlt');
}
const { Content } = await render(seite);
const hintergrund = bild('hintergruende/two.JPG');
const wechsel = gruppen.jugendwoche.map((name) => bild(`gruppenfotos/jugendwoche/${name}`));
const collage = jugend.collage.map((name) => bild(`jugend/${name}`));
---

<Base title={seite.data.title} description={seite.data.description} hintergrund={hintergrund}>
  <article class="wrap feature">
    <header class="page-head">
      {seite.data.kicker && <p class="kicker">{seite.data.kicker}</p>}
      <h1>{seite.data.title}</h1>
    </header>
    <Fotoreihe label="Gruppenfotos der Jugendwochen" fotos={wechsel.map((src) => ({ src, alt: '' }))} />
    <div class="prose team-copy">
      <Content />
    </div>
    <div class="collage">
      {
        collage.map((src, index) => (
          <button type="button" class="collage-open">
            <img src={src} alt={`Foto ${index + 1} aus der Jugendwoche`} loading="lazy" />
          </button>
        ))
      }
    </div>
    <dialog class="lightbox">
      <button class="lightbox-close" type="button">Schließen</button>
      <div class="lightbox-stage">
        <button class="lightbox-prev" type="button" aria-label="Vorheriges Foto">←</button>
        <img alt="" />
        <button class="lightbox-next" type="button" aria-label="Nächstes Foto">→</button>
      </div>
      <p class="lightbox-count"></p>
    </dialog>
  </article>
</Base>

<script>
  const collage = document.querySelector('.collage');
  const gap = 4;

  const layout = () => {
    if (!collage) return;
    const buttons = [...collage.querySelectorAll('button')];
    const width = collage.clientWidth;
    if (!width || buttons.length === 0) return;
    const target = width < 640 ? 118 : 168;
    const items = buttons.map((button) => {
      const img = button.querySelector('img');
      const ratio = img && img.naturalWidth ? img.naturalWidth / img.naturalHeight : 1.5;
      return { button, ratio };
    });
    const rows: { button: HTMLButtonElement; ratio: number }[][] = [];
    let row: { button: HTMLButtonElement; ratio: number }[] = [];
    let sum = 0;
    for (const item of items) {
      row.push(item);
      sum += item.ratio;
      if (sum * target + gap * (row.length - 1) >= width) {
        rows.push(row);
        row = [];
        sum = 0;
      }
    }
    if (row.length) rows.push(row);

    collage.replaceChildren();
    rows.forEach((group, rowIndex) => {
      const rowEl = document.createElement('div');
      rowEl.className = 'collage-row';
      const ratioSum = group.reduce((total, item) => total + item.ratio, 0);
      const natural = ratioSum * target + gap * (group.length - 1);
      const last = rowIndex === rows.length - 1 && natural < width * 0.92;
      const height = last ? target : (width - gap * (group.length - 1)) / ratioSum;
      rowEl.style.height = `${height}px`;
      for (const item of group) {
        item.button.style.flex = last ? '0 0 auto' : `${item.ratio} ${item.ratio} 0`;
        item.button.style.width = last ? `${height * item.ratio}px` : '';
        rowEl.append(item.button);
      }
      collage.append(rowEl);
    });
  };

  let frame = 0;
  const schedule = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(layout);
  };
  collage?.querySelectorAll('img').forEach((img) => {
    if (!img.complete) img.addEventListener('load', schedule);
  });
  schedule();
  window.addEventListener('resize', schedule);

  const dialog = document.querySelector('.lightbox');
  const view = dialog?.querySelector('img');
  const count = dialog?.querySelector('.lightbox-count');
  let photos: HTMLImageElement[] = [];
  let index = 0;

  const show = (next: number) => {
    if (!view || photos.length === 0) return;
    index = (next + photos.length) % photos.length;
    const photo = photos[index];
    view.src = photo.currentSrc || photo.src;
    view.alt = photo.alt;
    if (count) count.textContent = `${index + 1} / ${photos.length}`;
  };

  collage?.querySelectorAll('.collage-open').forEach((button) => {
    button.addEventListener('click', () => {
      photos = [...(collage.querySelectorAll('.collage-open img') ?? [])];
      const current = button.querySelector('img');
      show(photos.indexOf(current as HTMLImageElement));
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  document.querySelectorAll('.frame-open').forEach((button) => {
    button.addEventListener('click', () => {
      photos = [...button.querySelectorAll('img')];
      const current = button.querySelector('img.is-shown') || photos[0];
      show(Math.max(0, photos.indexOf(current)));
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  dialog?.querySelector('.lightbox-prev')?.addEventListener('click', () => show(index - 1));
  dialog?.querySelector('.lightbox-next')?.addEventListener('click', () => show(index + 1));
  dialog?.querySelector('.lightbox-close')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
  });
  dialog?.addEventListener('keydown', (event) => {
    if (!(event instanceof KeyboardEvent)) return;
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      show(index - 1);
    }
    if (event.key === 'ArrowRight') {
      event.preventDefault();
      show(index + 1);
    }
  });
</script>
