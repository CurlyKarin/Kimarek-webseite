---
import { getCollection } from 'astro:content';
import GalerieAnsicht from '../../components/GalerieAnsicht.astro';

const jahre = await getCollection('jahre');
const neuestes = jahre.reduce((bisher, eintrag) =>
  eintrag.data.year > bisher.data.year ? eintrag : bisher,
);
---

<GalerieAnsicht year={neuestes.data.year} />
