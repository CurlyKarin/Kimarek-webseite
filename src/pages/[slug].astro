---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const seiten = await getCollection('seiten');
  return seiten
    .filter(
      (seite) =>
        seite.id !== 'start' &&
        seite.id !== 'vorstand' &&
        seite.id !== 'betreuer' &&
        seite.id !== 'geschichte' &&
        seite.id !== 'zelt' &&
        seite.id !== 'kinderwoche' &&
        seite.id !== 'jugendwoche' &&
        seite.id !== 'ablauf',
    )
    .map((seite) => ({
      params: { slug: seite.id },
      props: { seite },
    }));
}

const { seite } = Astro.props;
const { Content } = await render(seite);
---

<Base title={seite.data.title} description={seite.data.description}>
  <article class="wrap">
    <header class="page-head">
      {seite.data.kicker && <p class="kicker">{seite.data.kicker}</p>}
      <h1>{seite.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
